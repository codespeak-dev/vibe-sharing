{
  "name": "codespeak-vibe-share",
  "version": "0.2.2",
  "description": "Share your vibe-coded project and AI coding sessions",
  "type": "module",
  "bin": {
    "codespeak-vibe-share": "./dist/index.js"
  },
  "exports": {
    "./sessions/*": "./dist/sessions/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./config": "./dist/config.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "tsc",
    "test": "vitest run && (cd session-viewer && npx vitest run) && playwright test",
    "test:root": "vitest run",
    "test:viewer": "cd session-viewer && npx vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "keywords": [
    "vibe-coding",
    "ai-sessions",
    "sharing"
  ],
  "author": "CodeSpeak <info@codespeak.dev> (https://codespeak.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/codespeak-dev/vibe-sharing.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "archiver": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "ink": "^6.8.0",
    "ora": "^8.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1043.0",
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/client-sns": "^3.1043.0",
    "@aws-sdk/client-ssm": "^3.1043.0",
    "@aws-sdk/lib-dynamodb": "^3.1043.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@playwright/test": "^1.59.1",
    "@types/archiver": "^6.0.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "aws-cdk-lib": "^2.252.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.6.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
